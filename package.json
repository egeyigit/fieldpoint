{
  "name": "fieldpoint",
  "version": "1.0.0",
  "description": "FieldPoint — site & asset map for field operations teams. Express + SQLite + Leaflet.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "node --check src/server.js && node scripts/lint.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "license": "MIT"
}
