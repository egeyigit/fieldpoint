# Copy to .env and adjust. All values optional in development.
PORT=4100
HOST=0.0.0.0
# SQLite file. Directory is created on boot.
DB_PATH=./data/fieldpoint.db
# REQUIRED in production (dev auto-generates one in data/.session-secret). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Session lifetime in hours
SESSION_TTL_HOURS=72
# Set to production to enable secure cookies + required secret
NODE_ENV=development
# Seed demo accounts + sites on boot (idempotent)
SEED_DEMO=true
# Comma-separated allowed origins for browser mutations (defaults to same-origin)
ALLOWED_ORIGINS=
# Days a soft-deleted site is kept before the sweeper hard-deletes it (unset = auto-purge off)
SITE_PURGE_AFTER_DAYS=
